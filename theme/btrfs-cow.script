// btrfs-cow: Plymouth script theme for the LUKS passphrase prompt.
//
// Every keystroke copies a leaf block and its path up to a new root, the way
// btrfs writes. A wrong passphrase aborts the transaction (the copies fall
// apart, the old root stays); the right one commits it.
//
// Layout lives in a 1920x1080 design space centred on the Plymouth canvas
// (PX/PY). With mixed-size monitors Plymouth draws every head from one canvas
// the size of the largest display and centres the smaller ones in it, so
// anything within 960x540 of the centre is visible on all of them.
//
// Sizes and offsets here must match tools/gen-assets.html.
//
// How the boot drives it:
//   display_password(prompt, bullets)  each keystroke / backspace / re-prompt
//   display_normal                     Enter: passphrase handed to cryptsetup
//   root_mounted                       plymouth-switch-root: unlock worked
//   display_password again, same prompt, while checking: wrong passphrase

// ---------------------------------------------------------------- filled in per initramfs
HOST = "@HOST@";
KERNEL = "@KERNEL@";
SUBVOL = "@SUBVOL@";
// Nicer names for LUKS volumes, keyed by the volume name systemd puts in
// "(...)" at the end of its prompt (its own disk name is the GPT partition
// label, e.g. "root"). One line per volume: DISK["luks-<uuid>"] = "...";
DISK["-"] = "";
// @DISKS@

// ---------------------------------------------------------------- settings
SESSION = "Hyprland";
GEN = 4127;                          // decorative
SPEED = 0.7;
LABELS = 1;                          // explanatory annotations
FONT = "JetBrainsMono Nerd Font Mono";   // must contain "Mono" for label-freetype

DX = 20;                             // offset of a CoW copy from its original
DY = -20;
EDGE_PAD = 16;
SEG = 150 / SPEED;                   // ms for the pulse to climb one level
APPEAR = 200 / SPEED;                // ms for a copy to fade in
FRAME_MS = 20;                       // Plymouth refreshes at 50 Hz
NEVER = -100000000;

fun Rgb(r, g, b) {
  local.c.r = r / 255;
  local.c.g = g / 255;
  local.c.b = b / 255;
  return local.c;
}
COL_TEXT = Rgb(138, 151, 173);
COL_DIM = Rgb(76, 88, 112);
COL_ACC = Rgb(94, 242, 184);
COL_OK = Rgb(126, 231, 135);
COL_ERR = Rgb(255, 92, 108);
COL_AMBER = Rgb(242, 179, 94);

// ---------------------------------------------------------------- canvas
Window.SetBackgroundTopColor(0.024, 0.031, 0.047);
Window.SetBackgroundBottomColor(0.024, 0.031, 0.047);

// The displays can change after the script starts: at boot Plymouth may begin
// with no display, or with the firmware framebuffer, and only get the real GPU
// (nvidia-drm) a second later. Layout() measures the displays and (re)builds
// everything that depends on them; it runs at start, on hotplug, and whenever
// display 0 changes size. Until there is a display, S stays 0 and nothing is
// drawn, but passphrase state is still tracked.
CANVAS_W = 0;
CANVAS_H = 0;
CANVAS_X = 0;
CANVAS_Y = 0;
CX = 0;
CY = 0;
S = 0;                               // design -> screen scale; 0 = not laid out yet
SEEN_W = -1;
SEEN_H = -1;

fun PX(x) { return CX + (x - 960) * S; }
fun PY(y) { return CY + (y - 540) * S; }

fun Img(name) {
  local.im = Image(name);
  if (S < 0.999)
    local.im = local.im.Scale(Math.Int(local.im.GetWidth() * S + 0.5), Math.Int(local.im.GetHeight() * S + 0.5));
  return local.im;
}

BLANK = Image("blank.png");
fun Txt(text, col, px) {
  local.sc = S;
  if (local.sc <= 0) local.sc = 1;
  local.im = Image.Text(text, col.r, col.g, col.b, 1, FONT + " " + Math.Int(px * 0.75 * local.sc + 0.5));
  // A text that can't be rendered must not take the rest of the theme down.
  if (!local.im) local.im = BLANK;
  return local.im;
}

fun NewSprite(z) {
  local.s = Sprite();
  local.s.SetZ(z);
  local.s.SetOpacity(0);
  return local.s;
}

// Place by centre / top-left / right edge / left edge, in design coordinates.
fun PlaceC(spr, x, y) {
  local.im = spr.GetImage();
  if (local.im) {
    spr.SetX(PX(x) - local.im.GetWidth() / 2);
    spr.SetY(PY(y) - local.im.GetHeight() / 2);
  }
}
fun PlaceTL(spr, x, y) {
  spr.SetX(PX(x));
  spr.SetY(PY(y));
}
fun PlaceR(spr, x, y) {
  local.im = spr.GetImage();
  if (local.im) {
    spr.SetX(PX(x) - local.im.GetWidth());
    spr.SetY(PY(y) - local.im.GetHeight() / 2);
  }
}
fun PlaceL(spr, x, y) {
  local.im = spr.GetImage();
  if (local.im) {
    spr.SetX(PX(x));
    spr.SetY(PY(y) - local.im.GetHeight() / 2);
  }
}

fun Ease(k) {
  local.m = 1 - k;
  return 1 - local.m * local.m * local.m;
}

fun IsPlaceholder(value, name) {
  return value == "@" + name + "@";
}

// ---------------------------------------------------------------- tree
NN = 0;
fun AddNode(kind, x, y, w, h, parent) {
  local.id = NN;
  global.node[local.id].kind = kind;
  global.node[local.id].x = x;
  global.node[local.id].y = y;
  global.node[local.id].w = w;
  global.node[local.id].h = h;
  global.node[local.id].parent = parent;
  global.NN = local.id + 1;
  return local.id;
}

ROOT = AddNode("root", 960, 300, 170, 64, -1);
NLEAF = 0;
for (gi = 0; gi < 3; gi++) {
  gx = 540 + gi * 420;
  ginner = AddNode("inner", gx, 450, 128, 52, ROOT);
  for (gj = 0; gj < 3; gj++) {
    LEAF[NLEAF] = AddNode("leaf", gx - 140 + gj * 140, 590, 88, 44, ginner);
    NLEAF++;
  }
}
// Scatter keystrokes across the tree rather than filling left to right.
ORDER[0] = LEAF[4]; ORDER[1] = LEAF[0]; ORDER[2] = LEAF[7];
ORDER[3] = LEAF[2]; ORDER[4] = LEAF[8]; ORDER[5] = LEAF[1];
ORDER[6] = LEAF[5]; ORDER[7] = LEAF[3]; ORDER[8] = LEAF[6];

fun GeomName(c) {
  local.p = node[c].parent;
  local.pre = "il-";
  if (node[local.p].kind == "root") local.pre = "ri-";
  local.d = node[c].x - node[local.p].x;
  if (local.d < 0) return local.pre + "l";
  if (local.d > 0) return local.pre + "r";
  return local.pre + "m";
}

// ---------------------------------------------------------------- images
KIND[0] = "root"; KIND[1] = "inner"; KIND[2] = "leaf";
NSTYLE[0] = "base"; NSTYLE[1] = "ghost"; NSTYLE[2] = "acc"; NSTYLE[3] = "white";
NSTYLE[4] = "ok"; NSTYLE[5] = "err"; NSTYLE[6] = "ring";
GEOM[0] = "ri-l"; GEOM[1] = "ri-m"; GEOM[2] = "ri-r";
GEOM[3] = "il-l"; GEOM[4] = "il-m"; GEOM[5] = "il-r";
ESTYLE[0] = "base"; ESTYLE[1] = "ghost"; ESTYLE[2] = "acc"; ESTYLE[3] = "ok"; ESTYLE[4] = "mixed";
PCOL[0] = "acc"; PCOL[1] = "err"; PCOL[2] = "ok";
DSIZE[0] = 4; DSIZE[1] = 7; DSIZE[2] = 10; DSIZE[3] = 13;

// Loads every image at the current scale S.
fun LoadImages() {
  local.i = 0;
  while (local.i < 3) {
    local.j = 0;
    while (local.j < 7) {
      global.NIMG[KIND[local.i]][NSTYLE[local.j]] = Img("node-" + KIND[local.i] + "-" + NSTYLE[local.j] + ".png");
      local.j = local.j + 1;
    }
    global.PANEL_IMG[PCOL[local.i]] = Img("panel-" + PCOL[local.i] + ".png");
    global.LOCK_IMG[PCOL[local.i]] = Img("lock-" + PCOL[local.i] + ".png");
    global.BUL_IMG[PCOL[local.i]] = Img("bullet-" + PCOL[local.i] + ".png");
    local.i = local.i + 1;
  }
  local.i = 0;
  while (local.i < 6) {
    local.j = 0;
    while (local.j < 5) {
      global.EIMG[GEOM[local.i]][ESTYLE[local.j]] = Img("edge-" + GEOM[local.i] + "-" + ESTYLE[local.j] + ".png");
      local.j = local.j + 1;
    }
    local.i = local.i + 1;
  }
  local.i = 0;
  while (local.i < 7) {
    global.PIMG[local.i] = Img("pulse-" + local.i + ".png");
    local.i = local.i + 1;
  }
  local.i = 0;
  while (local.i < 4) {
    global.DIMG[local.i] = Img("drift-" + DSIZE[local.i] + ".png");
    local.i = local.i + 1;
  }
  global.RING_IMG = Img("commit-ring.png");
  global.CURSOR_IMG = Img("cursor.png");
  // scaled to the canvas in PlaceAll()
  global.VIGNETTE_SRC = Image("vignette.png");
  global.RED_SRC = Image("pixel-red.png");
  global.BLACK_SRC = Image("pixel-black.png");
  global.BLOOM_SRC = Image("bloom.png");
}

// ---------------------------------------------------------------- sprites
// Created empty; ApplyImages() and MakeTexts() give them images once there
// is a display to size them for.
for (gi = 0; gi < NN; gi++) {
  NS[gi].base = NewSprite(10);
  NS[gi].ghost = NewSprite(11);
  NS[gi].acc = NewSprite(20);
  NS[gi].white = NewSprite(21);
  NS[gi].ok = NewSprite(22);
  NS[gi].ring = NewSprite(23);
  NS[gi].shard = NewSprite(40);
  cowBorn[gi] = -1;
  cowRem[gi] = -1;
  cowTouch[gi] = NEVER;
  SH[gi].t0 = NEVER;
}

// Edges belong to their child node. Image top-left is
// (min(x1, x2) - EDGE_PAD, y1 - EDGE_PAD) for an edge from (x1, y1) down to (x2, y2).
for (gi = 0; gi < NN; gi++) {
  gp = node[gi].parent;
  if (gp < 0) continue;
  E[gi].geom = GeomName(gi);
  E[gi].hx = Math.Min(node[gp].x, node[gi].x) - EDGE_PAD;
  E[gi].hy = node[gp].y + node[gp].h / 2 - EDGE_PAD;
  // copied parent (offset) -> untouched original child
  E[gi].mx = Math.Min(node[gp].x + DX, node[gi].x) - EDGE_PAD;
  E[gi].my = E[gi].hy + DY;
  ES[gi].base = NewSprite(5);
  ES[gi].ghost = NewSprite(6);
  ES[gi].acc = NewSprite(7);
  ES[gi].mixed = NewSprite(7);
  ES[gi].ok = NewSprite(8);
}

for (gi = 0; gi < 4; gi++) {
  PULSE[gi].t0 = NEVER;
  PULSE[gi].leaf = LEAF[0];
  for (gj = 0; gj < 7; gj++) PULSE_S[gi][gj] = NewSprite(30);
}

VIGNETTE = NewSprite(-100);
VIGNETTE.SetOpacity(1);
DRIFT_N = 46;
for (gi = 0; gi < DRIFT_N; gi++) {
  DR[gi].size = Math.Int(Math.Random() * 4);
  DR[gi].fx = Math.Random();         // position as a fraction of the canvas
  DR[gi].fy = Math.Random();
  DR[gi].v = 0.004 + Math.Random() * 0.012;
  DR[gi].s = NewSprite(-50);
  DR[gi].s.SetOpacity(0.03 + Math.Random() * 0.07);
}

RED = NewSprite(60);
BLOOM = NewSprite(61);
RING = NewSprite(24);
BLACK = NewSprite(90);
HANDOFF = NewSprite(95);

ANN_OLD = NewSprite(45);
ANN_NEW = NewSprite(45);
CAP_IDLE = NewSprite(45);
CAP_TYPING = NewSprite(45);
FOOTER = NewSprite(45);

PANEL = NewSprite(50);
LOCK = NewSprite(51);
for (gi = 0; gi < 22; gi++) BUL[gi] = NewSprite(52);
CURSOR = NewSprite(52);
LABEL = NewSprite(51);
PLUS = NewSprite(52);
ENTRY = NewSprite(52);
CAPS = NewSprite(52);
MSG = NewSprite(52);

if (IsPlaceholder(SUBVOL, "SUBVOL")) HANDOFF_TEXT = "mounting root";
else HANDOFF_TEXT = "mounting subvol=" + SUBVOL;
MODE = Plymouth.GetMode();
if (MODE == "shutdown" || MODE == "reboot")
  IDLE_CAPTION = "syncing  ·  committing the final transaction";
else
  IDLE_CAPTION = "btrfs never overwrites a block: changes are written as new copies, then a new root is committed";

fun ApplyImages() {
  local.i = 0;
  while (local.i < NN) {
    local.k = node[local.i].kind;
    NS[local.i].base.SetImage(NIMG[local.k]["base"]);
    NS[local.i].ghost.SetImage(NIMG[local.k]["ghost"]);
    NS[local.i].acc.SetImage(NIMG[local.k]["acc"]);
    NS[local.i].white.SetImage(NIMG[local.k]["white"]);
    NS[local.i].ok.SetImage(NIMG[local.k]["ok"]);
    NS[local.i].ring.SetImage(NIMG[local.k]["ring"]);
    NS[local.i].shard.SetImage(NIMG[local.k]["err"]);
    if (node[local.i].parent >= 0) {
      local.g = E[local.i].geom;
      ES[local.i].base.SetImage(EIMG[local.g]["base"]);
      ES[local.i].ghost.SetImage(EIMG[local.g]["ghost"]);
      ES[local.i].acc.SetImage(EIMG[local.g]["acc"]);
      ES[local.i].mixed.SetImage(EIMG[local.g]["mixed"]);
      ES[local.i].ok.SetImage(EIMG[local.g]["ok"]);
    }
    local.i = local.i + 1;
  }
  local.i = 0;
  while (local.i < 4) {
    local.j = 0;
    while (local.j < 7) {
      PULSE_S[local.i][local.j].SetImage(PIMG[local.j]);
      local.j = local.j + 1;
    }
    local.i = local.i + 1;
  }
  local.i = 0;
  while (local.i < DRIFT_N) {
    DR[local.i].s.SetImage(DIMG[DR[local.i].size]);
    local.i = local.i + 1;
  }
  RING.SetImage(RING_IMG);
  CURSOR.SetImage(CURSOR_IMG);
  global.PROMPT_COL = "";            // UpdatePrompt() re-applies panel, lock and bullets
}

// Text images depend on S (font size).
fun MakeTexts() {
  HANDOFF.SetImage(Txt(HANDOFF_TEXT + "  ·  starting " + SESSION, COL_TEXT, 22));
  ANN_OLD.SetImage(Txt("old root  ·  gen " + GEN + "  ·  still intact", COL_TEXT, 16));
  ANN_NEW.SetImage(Txt("new root  ·  gen " + (GEN + 1) + "  ·  uncommitted", COL_ACC, 16));
  CAP_IDLE.SetImage(Txt(IDLE_CAPTION, COL_DIM, 16));
  CAP_TYPING.SetImage(Txt("each keystroke copies a leaf and its path up to the root  ·  untouched blocks are shared, never overwritten", COL_DIM, 16));
  if (!IsPlaceholder(HOST, "HOST")) {
    FOOTER.SetImage(Txt(HOST + "  ·  linux " + KERNEL, COL_DIM, 15));
    FOOTER.SetOpacity(0.8);
  }
  CAPS.SetImage(Txt("caps lock", COL_AMBER, 14));
  LABEL.SetImage(Txt(PrettyPrompt(PROMPT_TEXT), COL_DIM, 15));
  ENTRY.SetImage(Txt(ENTRY_TEXT, COL_TEXT, 17));
  MSG.SetImage(Txt(MSG_SHOWN, MSG_COL, 17));
  global.PLUS_N = 0;                 // UpdatePrompt() re-renders "+N"
}

// Everything whose position or size depends on the canvas.
fun PlaceAll() {
  local.i = 0;
  while (local.i < NN) {
    PlaceC(NS[local.i].base, node[local.i].x, node[local.i].y);
    PlaceC(NS[local.i].ghost, node[local.i].x, node[local.i].y);
    if (node[local.i].parent >= 0) {
      PlaceTL(ES[local.i].base, E[local.i].hx, E[local.i].hy);
      PlaceTL(ES[local.i].ghost, E[local.i].hx, E[local.i].hy);
      PlaceTL(ES[local.i].mixed, E[local.i].mx, E[local.i].my);
    }
    local.i = local.i + 1;
  }
  local.i = 0;
  while (local.i < DRIFT_N) {
    global.DR[local.i].y = CANVAS_Y + DR[local.i].fy * CANVAS_H;
    DR[local.i].s.SetX(CANVAS_X + DR[local.i].fx * CANVAS_W);
    DR[local.i].s.SetY(DR[local.i].y);
    local.i = local.i + 1;
  }
  VIGNETTE.SetImage(VIGNETTE_SRC.Scale(CANVAS_W, CANVAS_H));
  VIGNETTE.SetX(CANVAS_X); VIGNETTE.SetY(CANVAS_Y);
  RED.SetImage(RED_SRC.Scale(CANVAS_W, CANVAS_H));
  RED.SetX(CANVAS_X); RED.SetY(CANVAS_Y);
  BLACK.SetImage(BLACK_SRC.Scale(CANVAS_W, CANVAS_H));
  BLACK.SetX(CANVAS_X); BLACK.SetY(CANVAS_Y);
  BLOOM.SetImage(BLOOM_SRC.Scale(1800 * S, 1800 * S));
  PlaceC(BLOOM, 960, 300);
  PlaceC(HANDOFF, 960, 540);
  PlaceR(ANN_OLD, 960 - 85 - 28, 300 + 14);
  PlaceL(ANN_NEW, 960 + DX + 85 + 28, 300 + DY);
  PlaceC(CAP_IDLE, 960, 170);
  PlaceC(CAP_TYPING, 960, 170);
  PlaceC(FOOTER, 960, 1027);
  PlaceC(MSG, 960, 865);
}

// Canvas = largest display. Everything is scaled down if any display is
// smaller than the 1920x1080 design.
fun Layout() {
  global.SEEN_W = Window.GetWidth(0);
  global.SEEN_H = Window.GetHeight(0);
  local.w = 0;
  local.h = 0;
  local.sc = 1;
  local.i = 0;
  while (local.i < 8) {
    local.dw = Window.GetWidth(local.i);
    local.dh = Window.GetHeight(local.i);
    if (!local.dw || !local.dh) break;
    local.w = Math.Max(local.w, local.dw);
    local.h = Math.Max(local.h, local.dh);
    local.sc = Math.Min(local.sc, Math.Min(local.dw / 1920, local.dh / 1080));
    local.i = local.i + 1;
  }
  if (local.w > 0) {
    global.CANVAS_W = local.w;
    global.CANVAS_H = local.h;
    global.CANVAS_X = Window.GetX();
    global.CANVAS_Y = Window.GetY();
    if (!CANVAS_X) global.CANVAS_X = 0;
    if (!CANVAS_Y) global.CANVAS_Y = 0;
    global.CX = CANVAS_X + CANVAS_W / 2;
    global.CY = CANVAS_Y + CANVAS_H / 2;
    if (local.sc != S) {
      global.S = local.sc;
      LoadImages();
      ApplyImages();
      MakeTexts();
    }
    PlaceAll();
  }
}

fun OnHotplug() {
  Layout();
}

// ---------------------------------------------------------------- state
T = 0;
PHASE = "idle";        // idle | input | check | abort | commit | done
PHASE_T = 0;
PROMPT_VISIBLE = 0;
PROMPT_KIND = "password";
PROMPT_TEXT = "";
PROMPT_COL = "acc";
CHARS = 0;
DEPTH = 0;             // keystrokes on the undo stack (== CHARS)
PULSE_NEXT = 0;
PLUS_N = 0;
ATTEMPT = 1;
SHAKE_T = NEVER;
FLASH_T = NEVER;
MSG_TEXT = "";
MSG_ERR = 0;
MSG_T = NEVER;
MSG_SHOWN = " ";        // what MSG currently renders, for re-rendering after Layout()
MSG_COL = COL_TEXT;
ENTRY_TEXT = " ";
BREATH = 1;
SLIDE = 0;
OKMIX = 0;
WHITE = 0;

// ---------------------------------------------------------------- transaction logic
// Copy-on-write alpha of node i: 0 = original only, 1 = copy fully shown.
fun Alpha(i) {
  if (cowBorn[i] < 0) return 0;
  local.a = Math.Clamp((T - cowBorn[i]) / APPEAR, 0, 1);
  if (cowRem[i] >= 0) local.a = local.a * (1 - Math.Clamp((T - cowRem[i]) / 220, 0, 1));
  return local.a;
}

fun Keystroke() {
  local.leaf = ORDER[CHARS % 9];
  local.n = DEPTH;
  local.id = local.leaf;
  local.k = 0;
  global.CHARS = CHARS + 1;
  global.STACK[local.n].count = 0;
  while (local.id >= 0) {
    local.when = T + local.k * SEG;
    if (cowBorn[local.id] < 0 || cowRem[local.id] >= 0) {
      global.cowBorn[local.id] = local.when;
      global.cowRem[local.id] = -1;
      global.STACK[local.n].ids[STACK[local.n].count] = local.id;
      global.STACK[local.n].count = STACK[local.n].count + 1;
    }
    // Already copied in this transaction: btrfs rewrites it in place (ring).
    global.cowTouch[local.id] = local.when;
    local.id = node[local.id].parent;
    local.k = local.k + 1;
  }
  global.PULSE[PULSE_NEXT].leaf = local.leaf;
  global.PULSE[PULSE_NEXT].t0 = T;
  global.PULSE_NEXT = (PULSE_NEXT + 1) % 4;
  global.DEPTH = local.n + 1;
}

fun Backspace() {
  if (DEPTH > 0) {
    global.DEPTH = DEPTH - 1;
    local.j = 0;
    while (local.j < STACK[DEPTH].count) {
      global.cowRem[STACK[DEPTH].ids[local.j]] = T;
      local.j = local.j + 1;
    }
  }
  if (CHARS > 0) global.CHARS = CHARS - 1;
}

fun ClearTransaction() {
  local.i = 0;
  while (local.i < NN) {
    global.cowBorn[local.i] = -1;
    global.cowRem[local.i] = -1;
    local.i = local.i + 1;
  }
  local.i = 0;
  while (local.i < 4) {
    global.PULSE[local.i].t0 = NEVER;
    local.i = local.i + 1;
  }
  global.CHARS = 0;
  global.DEPTH = 0;
}

fun SetMessage(text, col) {
  global.MSG_TEXT = text;
  global.MSG_ERR = (col.r == COL_ERR.r && col.g == COL_ERR.g);
  global.MSG_T = T;
  global.MSG_COL = col;
  global.MSG_SHOWN = text;
  if (text == "") global.MSG_SHOWN = " ";
  MSG.SetImage(Txt(MSG_SHOWN, col, 17));
  PlaceC(MSG, 960, 865);
}

fun Abort() {
  local.i = 0;
  while (local.i < NN) {
    if (Alpha(local.i) > 0) {
      global.SH[local.i].t0 = T;
      global.SH[local.i].x = node[local.i].x + DX;
      global.SH[local.i].y = node[local.i].y + DY;
      global.SH[local.i].vx = (Math.Random() - 0.5) * 0.25;
      global.SH[local.i].vy = -0.15 - Math.Random() * 0.2;
      global.SH[local.i].vr = (Math.Random() - 0.5) * 0.004;
    }
    local.i = local.i + 1;
  }
  ClearTransaction();
  global.PHASE = "abort";
  global.PHASE_T = T;
  global.SHAKE_T = T;
  global.FLASH_T = T;
  global.ATTEMPT = ATTEMPT + 1;
  SetMessage("transaction aborted  ·  generation " + GEN + " unchanged  ·  attempt " + ATTEMPT, COL_ERR);
}

fun Commit() {
  global.PHASE = "commit";
  global.PHASE_T = T;
  SetMessage("transaction committed  ·  generation " + (GEN + 1), COL_OK);
}

// A different device asking, or a prompt after we already committed.
fun ResetTree() {
  ClearTransaction();
  global.PHASE = "input";
  global.PHASE_T = T;
  global.ATTEMPT = 1;
  SetMessage("", COL_TEXT);
}

// "Please enter passphrase for disk X (luks-...):" -> "passphrase for <DISK entry>",
// or "passphrase for disk X (luks-...)" for a volume we have no name for.
fun PrettyPrompt(p) {
  if (!p || p == "") return " ";
  local.s = String(p);
  local.len = local.s.Length();
  if (local.s.SubString(0, 13) == "Please enter ") {
    local.s = String(local.s.SubString(13, local.len));
    local.len = local.len - 13;
  }
  if (local.len > 1 && local.s.SubString(local.len - 1, local.len) == ":") {
    local.s = String(local.s.SubString(0, local.len - 1));
    local.len = local.len - 1;
  }
  // volume name = text inside the last "(...)"
  local.open = -1;
  local.close = -1;
  local.i = local.len - 1;
  while (local.i >= 0 && local.open < 0) {
    local.ch = local.s.CharAt(local.i);
    if (local.ch == ")" && local.close < 0) local.close = local.i;
    if (local.ch == "(" && local.close >= 0) local.open = local.i;
    local.i = local.i - 1;
  }
  if (local.open >= 0) {
    local.vol = local.s.SubString(local.open + 1, local.close);
    if (DISK[local.vol]) return "passphrase for " + DISK[local.vol];
  }
  return local.s;
}

fun ShowPrompt(prompt, kind) {
  global.PROMPT_TEXT = prompt;
  global.PROMPT_KIND = kind;
  global.PROMPT_VISIBLE = 1;
  LABEL.SetImage(Txt(PrettyPrompt(prompt), COL_DIM, 15));
}

// ---------------------------------------------------------------- Plymouth callbacks
fun OnPassword(prompt, bullets) {
  if (PHASE == "check") {
    if (prompt == PROMPT_TEXT) Abort();
    else ResetTree();
  }
  else if (PHASE == "commit" || PHASE == "done") ResetTree();
  if (PHASE == "idle") global.PHASE = "input";

  local.n = 0;
  while (bullets > CHARS && local.n < 64) {
    Keystroke();
    local.n = local.n + 1;
  }
  while (bullets < CHARS) Backspace();

  if (!PROMPT_VISIBLE || PROMPT_KIND != "password" || prompt != PROMPT_TEXT) ShowPrompt(prompt, "password");
}

fun OnQuestion(prompt, entry) {
  if (!PROMPT_VISIBLE || PROMPT_KIND != "question" || prompt != PROMPT_TEXT) ShowPrompt(prompt, "question");
  global.ENTRY_TEXT = entry;
  if (!entry) global.ENTRY_TEXT = " ";
  ENTRY.SetImage(Txt(ENTRY_TEXT, COL_TEXT, 17));
}

// The entry was answered (Enter). For a passphrase, cryptsetup now checks it.
fun OnNormal() {
  if (PROMPT_VISIBLE && PROMPT_KIND == "question") global.PROMPT_VISIBLE = 0;
  else if (PROMPT_VISIBLE && (PHASE == "input" || PHASE == "abort")) {
    global.PHASE = "check";
    global.PHASE_T = T;
    SetMessage("unlocking …", COL_TEXT);
  }
}

fun OnRootMounted() {
  if (PHASE == "check") Commit();
}

fun OnMessage(text) {
  SetMessage(text, COL_TEXT);
}

fun OnHideMessage(text) {
  if (text == MSG_TEXT) SetMessage("", COL_TEXT);
}

// ---------------------------------------------------------------- per-frame drawing
fun UpdateDrift() {
  local.i = 0;
  while (local.i < DRIFT_N) {
    global.DR[local.i].y = DR[local.i].y - DR[local.i].v * S * FRAME_MS;
    if (DR[local.i].y < CANVAS_Y - 20) {
      global.DR[local.i].y = CANVAS_Y + CANVAS_H + 20;
      DR[local.i].s.SetX(CANVAS_X + Math.Random() * CANVAS_W);
    }
    DR[local.i].s.SetY(DR[local.i].y);
    local.i = local.i + 1;
  }
}

fun UpdateTree() {
  local.i = 0;
  while (local.i < NN) {
    local.a = Alpha(local.i);
    NS[local.i].base.SetOpacity(BREATH * (1 - local.a * (1 - SLIDE)));
    NS[local.i].ghost.SetOpacity(local.a * (1 - SLIDE));
    if (local.a > 0) {
      local.x = node[local.i].x + DX * (1 - SLIDE);
      local.y = node[local.i].y + DY * (1 - SLIDE);
      PlaceC(NS[local.i].acc, local.x, local.y);
      PlaceC(NS[local.i].white, local.x, local.y);
      PlaceC(NS[local.i].ok, local.x, local.y);
      PlaceC(NS[local.i].ring, local.x, local.y);
      NS[local.i].acc.SetOpacity(local.a);
      NS[local.i].white.SetOpacity(local.a * WHITE);
      NS[local.i].ok.SetOpacity(local.a * OKMIX);
      local.tk = (T - cowTouch[local.i]) / (320 / SPEED);
      if (local.tk > 0 && local.tk < 1) NS[local.i].ring.SetOpacity((1 - local.tk) * local.a);
      else NS[local.i].ring.SetOpacity(0);
    }
    else {
      NS[local.i].acc.SetOpacity(0);
      NS[local.i].white.SetOpacity(0);
      NS[local.i].ok.SetOpacity(0);
      NS[local.i].ring.SetOpacity(0);
    }
    local.i = local.i + 1;
  }
}

fun UpdateEdges() {
  local.c = 0;
  while (local.c < NN) {
    local.p = node[local.c].parent;
    if (local.p >= 0) {
      local.pa = Alpha(local.p);
      local.ca = Alpha(local.c);
      ES[local.c].base.SetOpacity(BREATH * (1 - local.pa * (1 - SLIDE)));
      ES[local.c].ghost.SetOpacity(local.pa * (1 - SLIDE));
      if (local.pa > 0 && local.ca > 0) {
        // copy -> copy: same shape as the original, shifted with the copies
        local.ox = E[local.c].hx + DX * (1 - SLIDE);
        local.oy = E[local.c].hy + DY * (1 - SLIDE);
        PlaceTL(ES[local.c].acc, local.ox, local.oy);
        PlaceTL(ES[local.c].ok, local.ox, local.oy);
        ES[local.c].acc.SetOpacity(local.pa * (1 - OKMIX));
        ES[local.c].ok.SetOpacity(local.pa * OKMIX);
        ES[local.c].mixed.SetOpacity(0);
      }
      else if (local.pa > 0) {
        // copied parent -> shared original child; on commit it settles home
        PlaceTL(ES[local.c].ok, E[local.c].hx, E[local.c].hy);
        ES[local.c].mixed.SetOpacity(local.pa * (1 - SLIDE));
        ES[local.c].ok.SetOpacity(local.pa * SLIDE);
        ES[local.c].acc.SetOpacity(0);
      }
      else {
        ES[local.c].acc.SetOpacity(0);
        ES[local.c].ok.SetOpacity(0);
        ES[local.c].mixed.SetOpacity(0);
      }
    }
    local.c = local.c + 1;
  }
}

// A dot climbs leaf -> inner -> root along the copies, with a short trail.
fun UpdatePulses() {
  local.total = SEG * 2;
  local.s = 0;
  while (local.s < 4) {
    local.e = T - PULSE[local.s].t0;
    local.j = 0;
    if (local.e < local.total + 250) {
      local.fade = 1 - Math.Clamp((local.e - local.total) / 250, 0, 1);
      while (local.j < 7) {
        local.f = Math.Clamp((local.e - local.j * 14) / local.total, 0, 1) * 2;
        local.lv = Math.Int(local.f);
        if (local.lv > 1) local.lv = 1;
        local.r = local.f - local.lv;
        local.lo = PULSE[local.s].leaf;
        if (local.lv == 1) local.lo = node[local.lo].parent;
        local.hi = node[local.lo].parent;
        local.x1 = node[local.lo].x + DX * (1 - SLIDE);
        local.y1 = node[local.lo].y - node[local.lo].h / 2 + DY * (1 - SLIDE);
        local.x2 = node[local.hi].x + DX * (1 - SLIDE);
        local.y2 = node[local.hi].y + node[local.hi].h / 2 + DY * (1 - SLIDE);
        PlaceC(PULSE_S[local.s][local.j], local.x1 + (local.x2 - local.x1) * local.r, local.y1 + (local.y2 - local.y1) * local.r);
        PULSE_S[local.s][local.j].SetOpacity(local.fade);
        local.j = local.j + 1;
      }
    }
    else {
      while (local.j < 7) {
        PULSE_S[local.s][local.j].SetOpacity(0);
        local.j = local.j + 1;
      }
    }
    local.s = local.s + 1;
  }
}

// Aborted copies tumble away.
fun UpdateShards() {
  local.i = 0;
  while (local.i < NN) {
    local.e = T - SH[local.i].t0;
    if (local.e >= 0 && local.e < 1100) {
      NS[local.i].shard.SetImage(NIMG[node[local.i].kind]["err"].Rotate(SH[local.i].vr * local.e));
      PlaceC(NS[local.i].shard,
             SH[local.i].x + SH[local.i].vx * local.e,
             SH[local.i].y + SH[local.i].vy * local.e + 0.0016 * local.e * local.e);
      NS[local.i].shard.SetOpacity(1 - local.e / 1100);
    }
    else NS[local.i].shard.SetOpacity(0);
    local.i = local.i + 1;
  }
}

fun UpdateAnnotations() {
  local.show = LABELS && PHASE != "commit" && PHASE != "done";
  local.ra = 0;
  if (local.show) local.ra = Alpha(ROOT);
  ANN_OLD.SetOpacity(local.ra * 0.9);
  ANN_NEW.SetOpacity(local.ra * 0.9);
  CAP_IDLE.SetOpacity(0);
  CAP_TYPING.SetOpacity(0);
  if (local.show && CHARS > 0) CAP_TYPING.SetOpacity(0.75);
  else if (local.show) CAP_IDLE.SetOpacity(0.75);
}

fun UpdatePrompt() {
  local.on = PROMPT_VISIBLE;
  local.b = 0;
  local.col = "acc";
  if (PHASE == "abort" || (MSG_ERR && T - MSG_T < 700)) local.col = "err";
  if (PHASE == "commit" || PHASE == "done") local.col = "ok";
  if (local.col != PROMPT_COL) {
    global.PROMPT_COL = local.col;
    PANEL.SetImage(PANEL_IMG[local.col]);
    LOCK.SetImage(LOCK_IMG[local.col]);
    while (local.b < 22) {
      BUL[local.b].SetImage(BUL_IMG[local.col]);
      local.b = local.b + 1;
    }
  }

  local.sx = 0;
  local.sk = (T - SHAKE_T) / 480;
  if (local.sk >= 0 && local.sk < 1) local.sx = Math.Sin(local.sk * Math.Pi * 9) * 16 * (1 - local.sk);

  PlaceC(PANEL, 960 + local.sx, 790);
  PlaceC(LOCK, 680 + local.sx, 790);
  LABEL.SetX(PX(644 + local.sx));
  LABEL.SetY(PY(743) - LABEL.GetImage().GetHeight());
  PANEL.SetOpacity(local.on);
  LOCK.SetOpacity(local.on);
  LABEL.SetOpacity(local.on);

  local.pw = local.on && PROMPT_KIND == "password";
  local.n = Math.Min(CHARS, 22);
  local.b = 0;
  while (local.b < 22) {
    if (local.pw && local.b < local.n) {
      PlaceC(BUL[local.b], 728 + local.b * 24 + local.sx, 790);
      local.op = 1;
      if (PHASE == "check") local.op = 0.35 + 0.65 * (0.5 + 0.5 * Math.Sin((T - PHASE_T) / 110 - local.b * 0.6));
      BUL[local.b].SetOpacity(local.op);
    }
    else BUL[local.b].SetOpacity(0);
    local.b = local.b + 1;
  }

  local.extra = 0;
  if (local.pw && CHARS > 22) {
    if (CHARS != PLUS_N) {
      global.PLUS_N = CHARS;
      PLUS.SetImage(Txt("+" + (CHARS - 22), COL_TEXT, 15));
    }
    PlaceL(PLUS, 720 + 22 * 24 + local.sx, 790);
    PLUS.SetOpacity(1);
    local.extra = 44;
  }
  else PLUS.SetOpacity(0);

  if (local.pw && PHASE == "input" && Math.Int(T / 530) % 2 == 0) {
    PlaceTL(CURSOR, 720 + local.n * 24 + local.extra + local.sx, 777);
    CURSOR.SetOpacity(1);
  }
  else CURSOR.SetOpacity(0);

  if (local.on && PROMPT_KIND == "question") {
    PlaceL(ENTRY, 720 + local.sx, 790);
    ENTRY.SetOpacity(1);
  }
  else ENTRY.SetOpacity(0);

  if (local.on && Plymouth.GetCapslockState()) {
    PlaceR(CAPS, 1260 + local.sx, 790);
    CAPS.SetOpacity(1);
  }
  else CAPS.SetOpacity(0);

  if (MSG_TEXT != "") MSG.SetOpacity(Math.Clamp((T - MSG_T) / 200, 0, 1));
  else MSG.SetOpacity(0);
}

fun UpdateOverlays() {
  local.fk = (T - FLASH_T) / 600;
  if (local.fk >= 0 && local.fk < 1) RED.SetOpacity(0.16 * (1 - local.fk));
  else RED.SetOpacity(0);

  if (PHASE == "commit" || PHASE == "done") {
    local.e = T - PHASE_T;
    // white bloom and an expanding ring on the new root
    local.bk = local.e / 450;
    if (local.bk < 1) BLOOM.SetOpacity(0.14 * (1 - local.bk));
    else BLOOM.SetOpacity(0);
    local.rk = local.e / 500;
    if (local.rk < 1) {
      RING.SetImage(RING_IMG.Scale(RING_IMG.GetWidth() + 60 * S * local.rk, RING_IMG.GetHeight() + 60 * S * local.rk));
      PlaceC(RING, 960 + DX * (1 - SLIDE), 300 + DY * (1 - SLIDE));
      RING.SetOpacity(1 - local.rk);
    }
    else RING.SetOpacity(0);
    // hand-off to the session
    BLACK.SetOpacity(Math.Clamp((local.e - 1600) / 800, 0, 1));
    HANDOFF.SetOpacity(Math.Clamp((local.e - 2300) / 500, 0, 1));
  }
  else {
    BLOOM.SetOpacity(0);
    RING.SetOpacity(0);
    BLACK.SetOpacity(0);
    HANDOFF.SetOpacity(0);
  }
}

fun Refresh() {
  global.T = T + FRAME_MS;
  // Belt and braces next to the hotplug callback: catch display changes here too.
  if (Window.GetWidth(0) != SEEN_W || Window.GetHeight(0) != SEEN_H) Layout();

  if (PHASE == "check" && T - PHASE_T > 8000) Commit();   // root_mounted never came
  if (PHASE == "abort" && T - PHASE_T > 700) global.PHASE = "input";
  if (PHASE == "commit" && T - PHASE_T > 2900) global.PHASE = "done";

  global.BREATH = 0.78 + 0.12 * Math.Sin(T / 1800 * 2 * Math.Pi);
  global.SLIDE = 0;
  global.OKMIX = 0;
  global.WHITE = 0;
  if (PHASE == "check") global.WHITE = 0.25 + 0.25 * Math.Sin((T - PHASE_T) / 90);
  if (PHASE == "commit" || PHASE == "done") {
    local.e = T - PHASE_T;
    global.SLIDE = Ease(Math.Clamp((local.e - 350) / 650, 0, 1));
    // flash to white, then settle on the success green
    if (local.e < 110) global.WHITE = local.e / 110;
    else global.WHITE = 1 - Math.Clamp((local.e - 110) / 450, 0, 1);
    global.OKMIX = Math.Clamp((local.e - 110) / 450, 0, 1);
  }

  // forget copies that finished fading out after a backspace
  local.i = 0;
  while (local.i < NN) {
    if (cowRem[local.i] >= 0 && T - cowRem[local.i] > 240) {
      global.cowBorn[local.i] = -1;
      global.cowRem[local.i] = -1;
    }
    local.i = local.i + 1;
  }

  if (S > 0) {
    UpdateDrift();
    UpdateEdges();
    UpdateTree();
    UpdatePulses();
    UpdateShards();
    UpdateAnnotations();
    UpdatePrompt();
    UpdateOverlays();
  }
}

Plymouth.SetRefreshFunction(Refresh);
Plymouth.SetDisplayPasswordFunction(OnPassword);
Plymouth.SetDisplayQuestionFunction(OnQuestion);
Plymouth.SetDisplayNormalFunction(OnNormal);
Plymouth.SetRootMountedFunction(OnRootMounted);
Plymouth.SetDisplayMessageFunction(OnMessage);
Plymouth.SetHideMessageFunction(OnHideMessage);
// Last, so an older Plymouth without it still has everything above.
Plymouth.SetDisplayHotplugFunction(OnHotplug);

// After the callbacks, so a failure while drawing can't stop the prompt working.
Layout();
